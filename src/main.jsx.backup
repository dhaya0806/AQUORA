import React, { useMemo, useState } from 'react';
import { createRoot } from 'react-dom/client';
import { Search, ShoppingCart, Droplets, SlidersHorizontal, ArrowUpRight, ShieldCheck, Truck, Headset, Menu, X, Plus, Minus, ArrowRight, CheckCircle2, Factory, Waves, House, Wrench, ChevronDown } from 'lucide-react';
import './style.css';

const products = [
 {id:'crossfields-uviolet',name:'UViolet UF + UV Water Purifier',brand:'Crossfields',category:'Commercial RO',price:16000,priceLabel:'From ₹16,000',status:'Manufacturer starting price · confirm configuration',type:'quote',capacity:'30–250 LPH options (model dependent)',tech:'UF + UV',desc:'Commercial water purifier/dispenser range. Available configurations and storage/dispensing options vary by model.',source:'https://www.crossfieldsindia.com/products/uviolet/',image:'',imageFallback:'UVIOLET',checked:'2026-10-13'},
 {id:'crossfields-uv-plus',name:'UV Plus Water Purifier',brand:'Crossfields',category:'Commercial RO',price:16000,priceLabel:'From ₹16,000',status:'Manufacturer starting price · confirm configuration',type:'quote',capacity:'75–250 LPH options (model dependent)',tech:'UV purification',desc:'Commercial UV water purifier range. Confirm the exact flow rate, storage and dispensing configuration with the manufacturer.',source:'https://www.crossfieldsindia.com/products/uv-plus/',image:'',imageFallback:'UV PLUS',checked:'2026-10-13'},
 {id:'crossfields-rio',name:'RiO RO + UV Water Purifier',brand:'Crossfields',category:'Commercial RO',price:19000,priceLabel:'From ₹19,000',status:'Manufacturer starting price · confirm configuration',type:'quote',capacity:'10–100 LPH options (model dependent)',tech:'RO + UV · designed for source water TDS 250–1250 ppm',desc:'RO + UV product range with multiple capacities and dispensing options. Final model and price depend on configuration.',source:'https://www.crossfieldsindia.com/products/rio/',image:'',imageFallback:'RIO RO',checked:'2026-10-13'},
 {id:'crossfields-ozone',name:'Best Water Doctor Ozone Purifier',brand:'Crossfields',category:'Commercial RO',price:48000,priceLabel:'From ₹48,000',status:'Manufacturer starting price · confirm configuration',type:'quote',capacity:'Configuration dependent',tech:'Ozone purification',desc:'Ozone-based water purifier/dispenser product family. Contact manufacturer to confirm the exact model and configuration.',source:'https://www.crossfieldsindia.com/products/ozone/',image:'',imageFallback:'OZONE',checked:'2026-10-13'},
 {id:'crossfields-uzone',name:'UZone UV + Ozone Water Purifier',brand:'Crossfields',category:'Commercial RO',price:49000,priceLabel:'From ₹49,000',status:'Manufacturer starting price · confirm configuration',type:'quote',capacity:'100–200 LPH options (model dependent)',tech:'UV + ozone disinfection',desc:'Combines UV treatment with ozone dosing for stored water. Available flow rates and dispensing configurations vary.',source:'https://www.crossfieldsindia.com/products/uzone/',image:'',imageFallback:'UZONE',checked:'2026-10-13'},
 {id:'crossfields-cooler',name:'Crossfields Water Cooler',brand:'Crossfields',category:'Commercial RO',price:20000,priceLabel:'From ₹20,000',status:'Manufacturer starting price · confirm configuration',type:'quote',capacity:'Multiple capacities; confirm with supplier',tech:'Water cooling / dispensing; purification depends on configuration',desc:'Water cooler range with normal, hot and/or cold dispensing options. This is not automatically a purifier; confirm the chosen configuration.',source:'https://www.crossfieldsindia.com/products/water-cooler/',image:'',imageFallback:'WATER COOLER',checked:'2026-10-13'},
 {id:'crossfields-industrial-ro',name:'Industrial RO Treatment Plant',brand:'Crossfields',category:'Industrial RO',price:null,priceLabel:'Price on Request',status:'Manufacturer quotation required',type:'quote',capacity:'100–10,000 LPH',tech:'Industrial reverse osmosis · pretreatment and post-treatment designed to source water',desc:'Industrial RO systems are configured after raw-water chemical/microbiological analysis. IoT monitoring may be available on request.',source:'https://www.crossfieldsindia.com/products/ro-plant/',image:'',imageFallback:'INDUSTRIAL RO',checked:'2026-10-13'},
 {id:'susbio-stp',name:'Sewage Treatment Plant (STP)',brand:'SUSBIO',category:'STP / ETP / WTP',price:null,priceLabel:'Price on Request',status:'Manufacturer quotation required',type:'quote',capacity:'Project-specific KLD',tech:'Wastewater treatment · process/capacity to be confirmed',desc:'Project-designed sewage treatment system. Request technical design and quote based on wastewater and discharge/reuse requirements.',source:'https://susbio.in/products-and-services/',image:'',imageFallback:'STP PLANT',checked:'2026-10-13'},
 {id:'susbio-etp',name:'Effluent Treatment Plant (ETP)',brand:'SUSBIO',category:'STP / ETP / WTP',price:null,priceLabel:'Price on Request',status:'Manufacturer quotation required',type:'quote',capacity:'Project-specific KLD',tech:'Industrial wastewater treatment',desc:'Industrial wastewater system requiring process selection based on the effluent profile and target discharge/reuse quality.',source:'https://susbio.in/products-and-services/',image:'',imageFallback:'ETP PLANT',checked:'2026-10-13'}
];
const categories = [
 {name:'All Machines',sub:'Explore the full catalogue',icon:Droplets},
 {name:'Home Purifiers',sub:'RO · UV · UF · Gravity',icon:House},
 {name:'Commercial RO',sub:'Offices · Hotels · Institutions',icon:Waves},
 {name:'Industrial RO',sub:'Process & high-capacity RO',icon:Factory},
 {name:'STP / ETP / WTP',sub:'Water & wastewater plants',icon:Droplets},
 {name:'Spare Parts',sub:'Membranes · Filters · Components',icon:Wrench}
];
const money = n => new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(n);
function App(){
 const [query,setQuery]=useState(''); const [category,setCategory]=useState('All Machines'); const [sort,setSort]=useState('featured'); const [mode,setMode]=useState('all'); const [cart,setCart]=useState([]); const [drawer,setDrawer]=useState(false); const [quote,setQuote]=useState(null); const [detail,setDetail]=useState(null); const [mobileMenu,setMobileMenu]=useState(false);
 const filtered=useMemo(()=>products.filter(p=>(category==='All Machines'||p.category===category)&& (mode==='all'||(mode==='buy'?p.type==='buy':p.type==='quote')) && `${p.name} ${p.brand} ${p.category} ${p.tech}`.toLowerCase().includes(query.toLowerCase())).sort((a,b)=>sort==='low'?(a.price??Infinity)-(b.price??Infinity):sort==='high'?(b.price??-1)-(a.price??-1):a.name.localeCompare(b.name)),[query,category,sort,mode]);
 const addCart=p=>{setCart(c=>{const old=c.find(x=>x.id===p.id);return old?c.map(x=>x.id===p.id?{...x,qty:x.qty+1}:x):[...c,{...p,qty:1}]})};
 const changeQty=(id,d)=>setCart(c=>c.map(x=>x.id===id?{...x,qty:x.qty+d}:x).filter(x=>x.qty>0));
 const total=cart.reduce((s,p)=>s+(p.price||0)*p.qty,0);
 const submitQuote=e=>{e.preventDefault();alert('Quote request demo only. Connect a backend/email service before accepting live requests.');setQuote(null)};
 return <div className="app">
  <div className="topline"><span>ENGINEERED FOR EVERY DROP</span><span className="top-right"><ShieldCheck size={14}/> India-focused catalogue <span className="dot">•</span> Price transparency first</span></div>
  <header className="header"><a className="brand" href="#top"><span className="brand-mark"><Droplets size={25}/></span><span><b>AQUORA</b><small>WATER TECHNOLOGY</small></span></a><nav className={mobileMenu?'nav open':'nav'}>{['Shop All','Home Purifiers','Commercial & Industrial','Treatment Plants','Spare Parts'].map((n,i)=><button key={n} onClick={()=>{setCategory(i===0?'All Machines':i===1?'Home Purifiers':i===2?'Industrial RO':i===3?'STP / ETP / WTP':'Spare Parts');setMobileMenu(false);document.getElementById('catalogue')?.scrollIntoView({behavior:'smooth'})}}>{n}</button>)}</nav><div className="header-actions"><button className="icon-button search-top" onClick={()=>document.getElementById('searchbox')?.focus()} aria-label="Search"><Search/></button><button className="cart-button" onClick={()=>setDrawer(true)}><ShoppingCart size={19}/><span>Cart</span><b>{cart.reduce((s,p)=>s+p.qty,0)}</b></button><button className="mobile-toggle" onClick={()=>setMobileMenu(!mobileMenu)}>{mobileMenu?<X/>:<Menu/>}</button></div></header>
  <main id="top"><section className="hero"><div className="hero-copy"><div className="eyebrow"><span className="eyebrow-line"/> WATER SOLUTIONS, MADE CLEAR</div><h1>Pure water.<br/><em>Smarter choices.</em></h1><p>Explore water purification and treatment equipment for homes, businesses and industry — with transparent pricing and supplier-backed details.</p><div className="hero-actions"><button className="primary" onClick={()=>document.getElementById('catalogue').scrollIntoView({behavior:'smooth'})}>Explore catalogue <ArrowRight size={17}/></button><button className="text-link" onClick={()=>setQuote({name:'Project enquiry'})}>Talk to a water specialist <ArrowUpRight size={16}/></button></div><div className="hero-proof"><span><CheckCircle2/> Verified-source pricing</span><span><CheckCircle2/> Quote-ready systems</span></div></div><div className="hero-art"><div className="orb orb1"/><div className="orb orb2"/><div className="hero-ring ring1"/><div className="hero-ring ring2"/><div className="water-drop"><Droplets size={92} strokeWidth={1.15}/></div><div className="hero-tag tag-a"><span className="tag-dot"/> HOME & COMMERCIAL</div><div className="hero-tag tag-b"><span className="tag-dot cyan"/> INDUSTRIAL SYSTEMS</div><div className="hero-note"><small>OUR PRINCIPLE</small><b>Clarity at every stage.</b><span>Specs · Pricing · Support</span></div></div><div className="hero-bottom"><span>01 / 05</span><div className="progress"><i/></div><span>WATER, BETTER</span></div></section>
  <section className="trust-strip"><div><ShieldCheck/><span><b>Source-backed details</b><small>Know where product info comes from</small></span></div><div><Truck/><span><b>India-first selection</b><small>Designed around local suppliers</small></span></div><div><Headset/><span><b>Help for complex systems</b><small>Request a project quotation</small></span></div></section>
  <section className="category-section"><div className="section-heading"><div><div className="eyebrow dark">FIND YOUR SOLUTION</div><h2>Shop by <em>category</em></h2></div><button className="text-link" onClick={()=>{setCategory('All Machines');document.getElementById('catalogue').scrollIntoView({behavior:'smooth'})}}>View all products <ArrowRight size={16}/></button></div><div className="category-grid">{categories.slice(1).map((c,i)=>{const Icon=c.icon;return <button className="category-card" key={c.name} onClick={()=>{setCategory(c.name);document.getElementById('catalogue').scrollIntoView({behavior:'smooth'})}}><span className="cat-icon"><Icon size={24}/></span><span className="cat-num">0{i+1}</span><b>{c.name}</b><small>{c.sub}</small><ArrowUpRight className="cat-arrow" size={18}/></button>})}</div></section>
  <section id="catalogue" className="catalogue"><div className="section-heading catalogue-heading"><div><div className="eyebrow dark">THE AQUORA CATALOGUE</div><h2>Water solutions, <em>well chosen.</em></h2><p className="section-sub">First verified manufacturer batch. “From” prices are starting prices, not final configured quotations.</p></div><span className="result-count">{filtered.length} LISTINGS</span></div><div className="catalogue-controls"><div className="searchbox"><Search size={19}/><input id="searchbox" value={query} onChange={e=>setQuery(e.target.value)} placeholder="Search machines, brands, technologies..."/><kbd>⌕</kbd></div><div className="control-right"><div className="filter-select"><SlidersHorizontal size={16}/><select value={category} onChange={e=>setCategory(e.target.value)}>{categories.map(c=><option key={c.name}>{c.name}</option>)}</select><ChevronDown size={14}/></div><select className="sort-select" value={sort} onChange={e=>setSort(e.target.value)}><option value="featured">Sort: A–Z</option><option value="low">Price: Low to high</option><option value="high">Price: High to low</option></select></div></div><div className="mode-tabs"><button className={mode==='all'?'active':''} onClick={()=>setMode('all')}>All listings</button><button className={mode==='buy'?'active':''} onClick={()=>setMode('buy')}>Ready to buy</button><button className={mode==='quote'?'active':''} onClick={()=>setMode('quote')}>Request a quote</button><span>Prices and availability can change; confirm with supplier.</span></div><div className="product-grid">{filtered.map((p,i)=><article className="product-card" key={p.id}><button className="product-image" onClick={()=>setDetail(p)} aria-label={`View ${p.name}`}><div className={'image-graphic graphic-'+(i%5)}>{p.image?<img src={p.image} alt={p.name} onError={e=>{e.currentTarget.style.display='none';e.currentTarget.parentElement.classList.add('no-real-image')}}/>:null}<div className="image-placeholder"><Droplets size={42}/><span>{p.imageFallback}</span><small>OPEN SOURCE FOR IMAGE</small></div><span className="image-corner">AQUORA / {String(i+1).padStart(2,'0')}</span></div></button><div className="product-info"><div className="product-meta"><span>{p.brand}</span><span className={p.type==='buy'?'status available':'status quote-status'}>{p.price!==null?'FROM PRICE':'QUOTE'}</span></div><button className="product-name" onClick={()=>setDetail(p)}>{p.name}</button><div className="product-spec"><span>{p.category}</span><span>{p.capacity}</span></div><div className="product-tech">{p.tech}</div><div className="product-price-row"><div><b>{p.priceLabel}</b><small>{p.status}</small></div>{p.type==='buy'?<button className="add-button" onClick={()=>addCart(p)} aria-label="Add to cart"><Plus size={19}/></button>:<button className="quote-mini" onClick={()=>setQuote(p)}>Get quote <ArrowUpRight size={14}/></button>}</div><a className="source-link" href={p.source} target="_blank" rel="noreferrer">View source <ArrowUpRight size={12}/></a></div></article>)}</div>{filtered.length===0&&<div className="empty"><Droplets size={30}/><h3>No matching products</h3><p>Try another search or category.</p><button className="primary" onClick={()=>{setQuery('');setCategory('All Machines');setMode('all')}}>Reset filters</button></div>}<div className="catalogue-foot"><span>Catalogue status: initial sourced batch</span><span>Images are not yet attached as verified direct image files; use each source link to view manufacturer product imagery.</span></div></section>
  <section className="quote-banner"><div className="quote-icon"><Factory size={28}/></div><div><div className="eyebrow">FOR INDUSTRIAL & PROJECT BUYERS</div><h2>Every project is different.<br/><em>Your quote should be too.</em></h2><p>Share your capacity, source water and application. Get the right system specification before you buy.</p></div><button className="light-button" onClick={()=>setQuote({name:'Industrial project enquiry'})}>Request a project quote <ArrowRight size={17}/></button></section>
  <section className="principles"><div><span className="principle-number">01</span><h3>Real details</h3><p>We distinguish verified supplier information from details still awaiting confirmation.</p></div><div><span className="principle-number">02</span><h3>Clear pricing</h3><p>Listed prices carry a source; custom systems show “Price on Request.”</p></div><div><span className="principle-number">03</span><h3>Built for India</h3><p>Prioritising India-market products, suppliers and serviceability.</p></div></section></main>
  <footer><a className="brand footer-brand" href="#top"><span className="brand-mark"><Droplets size={22}/></span><span><b>AQUORA</b><small>WATER TECHNOLOGY</small></span></a><p>Clear choices for better water.</p><span className="footer-copy">© 2026 AQUORA · Catalogue starter build</span></footer>
  {drawer&&<div className="overlay" onClick={()=>setDrawer(false)}><aside className="drawer" onClick={e=>e.stopPropagation()}><div className="drawer-head"><div><small>AQUORA CART</small><h2>Your selection ({cart.reduce((s,p)=>s+p.qty,0)})</h2></div><button className="icon-button" onClick={()=>setDrawer(false)}><X/></button></div>{cart.length===0?<div className="empty-cart"><ShoppingCart size={40}/><h3>Your cart is waiting</h3><p>Add a listed-price product to start your selection.</p><button className="primary" onClick={()=>setDrawer(false)}>Continue shopping</button></div>:<><div className="cart-lines">{cart.map(p=><div className="cart-line" key={p.id}><div className="cart-thumb"><Droplets/></div><div className="cart-line-info"><b>{p.name}</b><small>{p.priceLabel}</small><div className="qty"><button onClick={()=>changeQty(p.id,-1)}><Minus size={13}/></button><span>{p.qty}</span><button onClick={()=>changeQty(p.id,1)}><Plus size={13}/></button></div></div><b>{money(p.price*p.qty)}</b></div>)}</div><div className="cart-total"><span>Subtotal</span><b>{money(total)}</b></div><p className="cart-disclaimer">Demo checkout only. Payment and order processing are not connected yet.</p><button className="primary full" onClick={()=>alert('Checkout is not connected yet. Payment gateway and order backend must be configured before launch.')}>Continue to checkout <ArrowRight size={17}/></button></>}</aside></div>}
  {quote&&<div className="overlay" onClick={()=>setQuote(null)}><div className="modal" onClick={e=>e.stopPropagation()}><div className="modal-head"><div><small>PROJECT ENQUIRY</small><h2>Request a quote</h2><p>Tell us what you need. This starter form is not connected to a live backend yet.</p></div><button className="icon-button" onClick={()=>setQuote(null)}><X/></button></div><form onSubmit={submitQuote} className="quote-form"><label>Product / system<input defaultValue={quote.name||''} required/></label><div className="form-row"><label>Your name<input placeholder="Full name" required/></label><label>Phone / WhatsApp<input placeholder="+91" required/></label></div><div className="form-row"><label>Company<input placeholder="Company name (optional)"/></label><label>Required capacity<input placeholder="e.g. 10,000 L/day"/></label></div><label>Project details<textarea placeholder="Water source, application, location, required output..." rows="3"/></label><button className="primary full" type="submit">Submit enquiry <ArrowRight size={17}/></button></form></div></div>}
  {detail&&<div className="overlay" onClick={()=>setDetail(null)}><div className="modal detail-modal" onClick={e=>e.stopPropagation()}><button className="icon-button detail-close" onClick={()=>setDetail(null)}><X/></button><div className="detail-art"><Droplets size={58}/><span>{detail.imageFallback}</span><small>OPEN MANUFACTURER IMAGE</small></div><div className="detail-copy"><div className="eyebrow dark">{detail.brand} / {detail.category}</div><h2>{detail.name}</h2><p>{detail.desc}</p><div className="detail-price">{detail.priceLabel}<small>{detail.status}</small></div><div className="detail-facts"><div><small>CAPACITY</small><b>{detail.capacity}</b></div><div><small>TECHNOLOGY</small><b>{detail.tech}</b></div><div><small>PRICE SOURCE</small><a href={detail.source} target="_blank" rel="noreferrer">Manufacturer / supplier page <ArrowUpRight size={13}/></a></div></div><p className="detail-note">Verify current availability, installation, warranty and final delivered price with the supplier. Use the manufacturer source link to view current product imagery. Final configuration, warranty, installation and delivered price must be confirmed with the supplier.</p>{detail.type==='buy'?<button className="primary full" onClick={()=>{addCart(detail);setDetail(null);setDrawer(true)}}>Add to cart <ShoppingCart size={17}/></button>:<button className="primary full" onClick={()=>{setDetail(null);setQuote(detail)}}>Request a quote <ArrowRight size={17}/></button>}</div></div></div>}
 </div>
}

createRoot(document.getElementById('root')).render(<App/>);
